# Walrus Memory (mainnet). Create an account + delegate key at https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Namespace prefix. Change it to start a clean memory (e.g. kafka2).
KAFKA_NS=0xkafka
# MEMWAL_MOCK=1   # local only: in-process mock memory, nothing is written to Walrus

# Tatum (Sui gRPC + Price API). https://dashboard.tatum.io
TATUM_API_KEY=

# LLM: Boundless (OpenAI-compatible)
LLM_BASE_URL=https://api.inference.boundless.network/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash-0731

# Payments (MPP on Sui): 0xkafka's Sui address that receives USDC
KAFKA_SUI_ADDRESS=
# HMAC secret for MPP challenges (32+ chars)
MPP_SECRET_KEY=
PUBLIC_URL=https://0xkafka.xyz

# Optional, for the MCP server (scripts/mcp.ts) to buy signals: a wallet holding a little USDC + SUI
BUYER_PRIVATE_KEY=
KAFKA_URL=https://0xkafka.xyz

# SQLite cache (Walrus is the source of truth)
KAFKA_DB=./data/kafka.db
